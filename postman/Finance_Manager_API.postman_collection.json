{
  "info": {
    "_postman_id": "bf0eeb07-72d6-4cc6-a6c4-53d7f1ae13ed",
    "name": "Finance Manager API",
    "description": "Colección completa de endpoints para Finance Manager API (NestJS + TypeORM + MySQL). Incluye autenticación Bearer dinámica, variables de entorno, scripts de prueba para auto-guardar tokens e IDs, y soporte completo de CRUD para cuentas, categorías y transacciones atómicas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "description": "URL base por defecto si no está definida en el entorno"
    }
  ],
  "item": [
    {
      "name": "01 - Autenticación (Auth)",
      "description": "Endpoints de registro e inicio de sesión con JWT. Los tests automáticos almacenan el accessToken y userId en el entorno.",
      "item": [
        {
          "name": "Registrar Usuario (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registro exitoso (Status 201)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.environment.set(\"token\", res.accessToken);",
                  "    console.log(\"Token guardado automáticamente en el entorno\");",
                  "}",
                  "if (res.user && res.user.id) {",
                  "    pm.environment.set(\"userId\", res.user.id);",
                  "    console.log(\"userId guardado: \" + res.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@ejemplo.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Brayan\",\n  \"lastName\": \"Garcia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Crea una nueva cuenta de usuario y retorna el token JWT y el perfil de usuario."
          }
        },
        {
          "name": "Iniciar Sesión (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login exitoso (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.environment.set(\"token\", res.accessToken);",
                  "    console.log(\"Token guardado automáticamente en el entorno\");",
                  "}",
                  "if (res.user && res.user.id) {",
                  "    pm.environment.set(\"userId\", res.user.id);",
                  "    console.log(\"userId guardado: \" + res.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@ejemplo.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Inicia sesión con credenciales válidas y retorna un nuevo accessToken."
          }
        }
      ]
    },
